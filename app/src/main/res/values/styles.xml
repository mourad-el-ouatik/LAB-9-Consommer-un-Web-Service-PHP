<?xml version="1.0" encoding="utf-8"?>
<!--
    ╔══════════════════════════════════════════════════════════════╗
    ║  styles.xml  ≡  styles.css / variables CSS                  ║
    ║  Rôle : Feuille de styles globale réutilisable.             ║
    ║         Comme CSS, on définit une fois, on applique partout ║
    ║         via style="@style/NomDuStyle" dans les layouts XML. ║
    ╚══════════════════════════════════════════════════════════════╝
-->
<resources>

    <!--
        Style "label" : équivalent d'une classe CSS .label {}
        Appliqué aux TextView (étiquettes de champs).
        Couleur : bleu profond moderne (#1565C0) — identité visuelle.
    -->
    <style name="label">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#1565C0</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:paddingTop">12dp</item>
    </style>

    <!--
        Style "input" : équivalent d'une classe CSS .input {}
        Appliqué aux EditText, Spinner (champs de saisie).
    -->
    <style name="input">
        <item name="android:paddingBottom">8dp</item>
        <item name="android:background">@drawable/input_bg</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">#212121</item>
    </style>

    <!--
        Style "btnPrimary" : bouton principal de l'application.
        Équivalent d'une classe CSS .btn-primary {}
        Couleur orange (#E65100) = couleur d'action principale.
    -->
    <style name="btnPrimary">
        <item name="android:backgroundTint">#E65100</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:elevation">4dp</item>
    </style>

</resources>